@page "/"

<PageTitle>Spooky Llama</PageTitle>

<h1>Spooky Llama</h1>

<h2>Welcome to Spooky Llama!</h2>
<p>Enter a prompt to generate a spooky story:</p>

<input type="text" @bind-value="@Prompt" disabled="@(IsGenerating || IsGeneratingVideo)" />
<button @onclick="GenerateAndPlay" disabled="@(IsGenerating || IsGeneratingVideo)">
    @(IsGenerating ? "Generating..." : "Generate")
</button>
<audio @ref="audioPlayer" controls></audio>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p role="alert">@ErrorMessage</p>
}
<br />

<button @onclick="GetLatestResponse">Get Latest Response</button>
@if (!string.IsNullOrEmpty(LatestResponse))
{
    <h3>Latest Response:</h3>
    <p>@LatestResponse</p>
}
<br />

<button @onclick="GetAllResponses">Get All Responses</button>
<button @onclick="ClearResponses">Clear Responses</button>
<br />
@if (Responses.Any())
{
    <h3>All Responses:</h3>
    <ul>
        @foreach (var response in Responses)
        {
            <li>@response</li>
        }
    </ul>
}

<section class="image-studio" aria-labelledby="image-studio-title">
    <header class="image-studio__header">
        <h2 id="image-studio-title">Nightmare frame</h2>
        <span>DreamShaper 8 · 512 × 512</span>
    </header>

    <div class="image-stage" aria-busy="@IsGeneratingImage" aria-live="polite">
        <img @ref="generatedImage"
             class="@(HasGeneratedImage ? null : "image-stage__image--hidden")"
             alt="Generated illustration for: @ImagePrompt" />
        @if (!HasGeneratedImage)
        {
            <p>@(IsGeneratingImage ? "Generating image on CPU. This can take up to two minutes." : "No image generated")</p>
        }
    </div>

    <label for="image-prompt">Image prompt</label>
    <textarea id="image-prompt"
              rows="3"
              maxlength="500"
              @bind="ImagePrompt"
              @bind:event="oninput"
                            disabled="@(IsGeneratingImage || IsGeneratingVideo)"></textarea>
    <button @onclick="GenerateImage"
                        disabled="@(IsGeneratingImage || IsGeneratingVideo || string.IsNullOrWhiteSpace(ImagePrompt))">
        @(IsGeneratingImage ? "Generating image..." : "Generate image")
    </button>
    @if (!string.IsNullOrEmpty(ImageMetadata))
    {
        <small>@ImageMetadata</small>
    }
</section>

<section class="video-studio" aria-labelledby="video-studio-title">
    <header class="video-studio__header">
        <h2 id="video-studio-title">Story reel</h2>
        <span>MP4 · 30 fps</span>
    </header>

    <div class="video-stage" aria-busy="@IsGeneratingVideo" aria-live="polite">
        <video @ref="videoPlayer"
               class="@(HasGeneratedVideo ? null : "video-stage__video--hidden")"
               controls
               preload="metadata"></video>
        @if (!HasGeneratedVideo)
        {
            <p>@(IsGeneratingVideo ? "Composing video..." : "No video generated")</p>
        }
    </div>

    <button @onclick="GenerateVideo"
            disabled="@(IsGenerating || IsGeneratingImage || IsGeneratingVideo || string.IsNullOrWhiteSpace(latestMediaPrompt))">
        @(IsGeneratingVideo ? "Composing video..." : "Generate video")
    </button>
</section>

<br />
<p>Want a new context for your story? Click the button below:</p>
<button @onclick="ClearContext">Clear Context</button>